// ═══════════════════════════════════════════════════════════════════
// قواعدُ فايرستور لمنصّة «إشراف المدرسة»
// ───────────────────────────────────────────────────────────────────
// الخيار (أ) مشروعٌ مستقلّ: انسخِ الملفَّ كلَّه إلى تبويب Rules في Firebase Console ثم Publish.
// الخيار (ب) المشروعُ المشترك (vak-quiz-96d5f): انسخْ فقط الكتلةَ التي بين
//            «بدايةُ كتلة إشراف» و«نهايةُ كتلة إشراف» داخل match /databases/{database}/documents { … }
//            مع بقاءِ القواعدِ الأخرى (answers/feedback/lawha/ft_*/sc_*) كما هي، ثم Publish.
// غيّرِ البريدَ في esAdmin() إذا تغيّرَ المشرف (ويجبُ أن يطابقَ ADMINS في js/config.js).
// ═══════════════════════════════════════════════════════════════════
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══ بدايةُ كتلة إشراف المدرسة ═══
    // المشرفُ (أو المشرفون) — قراءةٌ وكتابةٌ كاملة
    function esAdmin() {
      return request.auth != null && request.auth.token.email in [
        'naifnaser95@gmail.com'
      ];
    }
    // مشرفٌ قارئ: بريدُه في es_meta/access.viewers (تُكتَبُ من الإعدادات)
    function esViewer() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/es_meta/access) &&
        request.auth.token.email in get(/databases/$(database)/documents/es_meta/access).data.viewers;
    }
    match /es_meta/{doc}    { allow read: if esAdmin() || esViewer(); allow write: if esAdmin(); }
    match /es_classes/{doc} { allow read: if esAdmin() || esViewer(); allow write: if esAdmin(); }
    match /es_days/{doc}    { allow read: if esAdmin() || esViewer(); allow write: if esAdmin(); }
    match /es_log/{doc}     { allow read: if esAdmin() || esViewer(); allow write: if esAdmin(); }
    // ═══ نهايةُ كتلة إشراف المدرسة ═══

  }
}
